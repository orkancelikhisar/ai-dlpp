    "@sih/tier2": "workspace:*",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mlc-ai/web-llm": "0.2.84",
    "@playwright/test": "^1.50.0",
    "@types/node": "^20.0.0",
